    "window_bg": "#070B12",
    "panel": "#111A27",
    "panel_elevated": "#1A2A3D",
    "control_bg": "#0B1420",
    "control_face": "#263548",
    "control_border": "#49627B",
    "text_primary": "#F3F8FF",
    "text_secondary": "#B5C7D9",
    "text_disabled": "#71849A",
    "accent": "#12CFFF",
    "accent_glow": "#397CFF",
