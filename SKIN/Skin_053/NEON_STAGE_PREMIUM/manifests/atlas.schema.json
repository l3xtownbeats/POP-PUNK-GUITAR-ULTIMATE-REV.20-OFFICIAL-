{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEON STAGE PREMIUM atlas entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "atlas",
    "image",
    "width",
    "height",
    "format",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "atlas": {
      "type": "string"
    },
    "image": {
      "type": "string",
      "pattern": "\\.png$"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "format": {
      "const": "PNG"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "x",
          "y",
          "width",
          "height",
          "pivotX",
          "pivotY"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "pivotX": {
            "type": "number"
          },
          "pivotY": {
            "type": "number"
          },
          "state": {
            "type": "string"
          }
        }
      }
    }
  }
}
